{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: clang++ 生成活动文件",
            "type": "shell",
            "command": "mkdir -p \"${fileDirname}/bin\" && /usr/bin/clang++ -fcolor-diagnostics -std=c++17 -g \"${file}\" -o \"${fileDirname}/bin/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "产物（可执行 + .dSYM）全部落在 bin/，根目录只留 .cpp"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ 生成活动文件",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}